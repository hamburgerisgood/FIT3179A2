{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Bump chart: running rank of the ten artists with three or more wins, measured every five years. Rank 1 = most wins so far. Ties are broken by total career wins, then alphabetically.",
  "width": 540,
  "height": 330,
  "data": {"url": "data/aria_wins.csv", "format": {"type": "csv", "parse": {"year": "number"}}},
  "transform": [
    {"joinaggregate": [{"op": "count", "as": "career"}], "groupby": ["artist"]},
    {"filter": "datum.career >= 3"},
    {"calculate": "ceil(datum.year / 5) * 5", "as": "checkpoint"},
    {"aggregate": [{"op": "count", "as": "n"}], "groupby": ["artist", "checkpoint", "career"]},
    {
      "impute": "n",
      "key": "checkpoint",
      "keyvals": [1990, 1995, 2000, 2005, 2010, 2015, 2020, 2025],
      "groupby": ["artist", "career"],
      "value": 0
    },
    {
      "window": [{"op": "sum", "field": "n", "as": "so_far"}],
      "groupby": ["artist"],
      "sort": [{"field": "checkpoint", "order": "ascending"}],
      "frame": [null, 0]
    },
    {"filter": "datum.so_far > 0"},
    {
      "window": [{"op": "row_number", "as": "rank"}],
      "groupby": ["checkpoint"],
      "sort": [
        {"field": "so_far", "order": "descending"},
        {"field": "career", "order": "descending"},
        {"field": "artist", "order": "ascending"}
      ]
    }
  ],
  "encoding": {
    "x": {
      "field": "checkpoint",
      "type": "ordinal",
      "title": null,
      "axis": {
        "labelExpr": "'by ' + datum.label",
        "labelAngle": 0,
        "domain": false,
        "ticks": false,
        "grid": true,
        "gridColor": "#efe9df"
      }
    },
    "y": {
      "field": "rank",
      "type": "ordinal",
      "title": "Rank by wins so far",
      "axis": {"domain": false, "ticks": false}
    },
    "color": {
      "field": "artist",
      "type": "nominal",
      "legend": null,
      "scale": {
        "domain": [
          "Kasey Chambers",
          "Troy Cassar-Daley",
          "Tame Impala",
          "Powderfinger",
          "John Williamson",
          "INXS",
          "The Cruel Sea",
          "Silverchair",
          "Keith Urban",
          "Amyl and the Sniffers"
        ],
        "range": [
          "#6f8f3d",
          "#a7b36a",
          "#c9971f",
          "#d55e00",
          "#4f7a3a",
          "#4a4e8c",
          "#7b8cc4",
          "#0072B2",
          "#8c7b6b",
          "#CC79A7"
        ]
      }
    },
    "opacity": {"condition": {"param": "hover", "empty": true, "value": 1}, "value": 0.15}
  },
  "layer": [
    {"mark": {"type": "line", "strokeWidth": 3, "interpolate": "monotone"}},
    {
      "mark": {"type": "circle", "size": 150, "stroke": "#fbf8f3", "strokeWidth": 1.5},
      "encoding": {
        "tooltip": [
          {"field": "artist", "title": "Artist"},
          {"field": "checkpoint", "title": "By the end of"},
          {"field": "so_far", "title": "Wins so far"},
          {"field": "rank", "title": "Rank"}
        ]
      },
      "params": [
        {
          "name": "hover",
          "select": {
            "type": "point",
            "fields": ["artist"],
            "on": "mouseover",
            "clear": "mouseout",
            "nearest": true
          }
        }
      ]
    },
    {
      "transform": [
        {"filter": "datum.checkpoint === 2025"},
        {"calculate": "datum.artist + ' (' + datum.so_far + ')'", "as": "label"}
      ],
      "mark": {"type": "text", "align": "left", "dx": 12, "fontSize": 11, "fontWeight": 600},
      "encoding": {"text": {"field": "label"}}
    },
    {
      "mark": {"type": "text", "fontSize": 9, "fontWeight": 700, "color": "#fffaf0"},
      "encoding": {"text": {"field": "so_far"}, "color": {"value": "#fffaf0"}}
    }
  ]
}
