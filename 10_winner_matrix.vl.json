{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Heatmap of every winner: one cell per award per year, shaded by the winner's total career wins across the three awards. Hover a cell to light up the same artist.",
  "data": {
    "url": "data/aria_wins.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number"
      }
    }
  },
  "transform": [
    {
      "joinaggregate": [
        {
          "op": "count",
          "as": "career"
        }
      ],
      "groupby": [
        "artist"
      ]
    }
  ],
  "width": {
    "step": 14
  },
  "height": {
    "step": 40
  },
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#fbf8f3",
        "strokeWidth": 1
      },
      "params": [
        {
          "name": "hoverArtist",
          "select": {
            "type": "point",
            "fields": [
              "artist"
            ],
            "on": "mouseover",
            "clear": "mouseout"
          }
        }
      ],
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": null,
          "scale": {
            "domain": [
              1987,
              1988,
              1989,
              1990,
              1991,
              1992,
              1993,
              1994,
              1995,
              1996,
              1997,
              1998,
              1999,
              2000,
              2001,
              2002,
              2003,
              2004,
              2005,
              2006,
              2007,
              2008,
              2009,
              2010,
              2011,
              2012,
              2013,
              2014,
              2015,
              2016,
              2017,
              2018,
              2019,
              2020,
              2021,
              2022,
              2023,
              2024,
              2025
            ]
          },
          "axis": {
            "labelExpr": "datum.value % 5 === 0 || datum.value === 1987 ? datum.value : ''",
            "labelAngle": 0,
            "domain": false,
            "ticks": false,
            "labelOverlap": false
          }
        },
        "y": {
          "field": "category",
          "type": "nominal",
          "title": null,
          "sort": [
            "Album of the Year",
            "Best Group",
            "Best Country Album"
          ],
          "axis": {
            "domain": false,
            "ticks": false,
            "labelFontWeight": 600,
            "labelColor": "#1f1c18",
            "labelFontSize": 11.5
          }
        },
        "color": {
          "field": "career",
          "type": "quantitative",
          "title": "Winner's career wins (all three awards)",
          "scale": {
            "type": "linear",
            "domain": [
              1,
              11
            ],
            "range": [
              "#f6ecd3",
              "#e0b660",
              "#a36a12",
              "#5c3a08"
            ],
            "interpolate": "hcl"
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "gradientLength": 240,
            "titleLimit": 400,
            "values": [
              1,
              3,
              5,
              7,
              9,
              11
            ]
          }
        },
        "opacity": {
          "condition": {
            "param": "hoverArtist",
            "empty": true,
            "value": 1
          },
          "value": 0.22
        },
        "tooltip": [
          {
            "field": "year",
            "title": "Year"
          },
          {
            "field": "category",
            "title": "Award"
          },
          {
            "field": "winner",
            "title": "Winner"
          },
          {
            "field": "work",
            "title": "For"
          },
          {
            "field": "artist",
            "title": "Artist"
          },
          {
            "field": "career",
            "title": "Artist's career wins"
          },
          {
            "field": "place",
            "title": "Hometown"
          },
          {
            "field": "state",
            "title": "State"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.career >= 5"
        },
        {
          "calculate": "{'Kasey Chambers':'KC','Tame Impala':'TI','Troy Cassar-Daley':'TC','Powderfinger':'P'}[datum.artist]",
          "as": "initials"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 8.5,
        "fontWeight": 700
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal"
        },
        "y": {
          "field": "category",
          "type": "nominal",
          "sort": [
            "Album of the Year",
            "Best Group",
            "Best Country Album"
          ]
        },
        "text": {
          "field": "initials"
        },
        "color": {
          "condition": {
            "test": "datum.career >= 8",
            "value": "#fffaf0"
          },
          "value": "#1f1c18"
        },
        "opacity": {
          "condition": {
            "param": "hoverArtist",
            "empty": true,
            "value": 1
          },
          "value": 0.22
        }
      }
    }
  ]
}