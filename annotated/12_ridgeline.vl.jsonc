// 图 12：山脊图 (ridgeline) — Vega-Lite
// 每个州一条平滑的曲线，横轴年份，曲线高度 = 那几年该州的获奖密度；曲线下面积 = 总获奖数。
// 关键点：density + counts:true；facet row；spacing 为负数让山脊重叠；y range 超出让山峰伸进上一行。
// 面试一句话：A kernel density per state with counts turned on, faceted by row with negative spacing so the ridges overlap.
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",  // › 声明这是 Vega-Lite / Vega 的哪个版本，编辑器据此做提示
  "description": "Ridgeline plot: a smoothed timeline of each state's wins. The taller the ridge around a year, the more wins that state collected around then. Area under each ridge = that state's total wins.",  // › 这张图的文字说明（给读屏软件和读代码的人看，不影响画面）
  "data": {"url": "data/aria_wins.csv", "format": {"type": "csv", "parse": {"year": "number"}}},  // › 数据来源。url 指向 data/ 里的文件，或用 values 直接内嵌
  "transform": [  // › 数据变换管道：按顺序一步一步加工数据，上一步的输出是下一步的输入
    {"filter": "datum.state !== 'Unknown'"},  // › 去掉没有州信息的行
    {"joinaggregate": [{"op": "count", "as": "total"}], "groupby": ["state"]},  // › 聚合，但结果写回每一行，不会减少行数（用来给每行加“总数”之类）
    {
      "density": "year",  // › 核密度估计：把离散点变成一条平滑的曲线
      "groupby": ["state", "total"],  // › 按 ["state", "total"] 分组，每组单独计算
      "extent": [1987, 2025],  // › 计算的范围 [最小, 最大]
      "bandwidth": 2.2,  // › 平滑程度：越大越平滑，越小越尖
      "counts": true,  // › true 表示曲线下面积=数量（而不是 1），这样各组才能比较高低
      "steps": 180  // › 曲线上取多少个点
    },
    {"calculate": "datum.state + '  (' + datum.total + ')'", "as": "row_label"}  // › 新字段：标签：州名 + 括号里的总数，例如 NSW  (46)
  ],
  "facet": {  // › 分面：按一个字段拆成很多小图（small multiples）
    "row": {  // › 每个值一行（垂直排列的小图）
      "field": "row_label",  // › 使用数据里的 “row_label” 这一列
      "type": "nominal",  // › 数据类型：名义（类别，没有顺序）
      "sort": {"field": "total", "op": "max", "order": "descending"},  // › 排序方式：按哪个字段、升序还是降序
      "title": null,  // › 不显示标题
      "header": null  // › 分面标题的样式；null 不显示
    }
  },
  "spacing": -26,  // › 分面各小图的间距；负数让它们重叠（山脊图用）
  "bounds": "flush",  // › 计算大小时是否包含图外的文字，flush 表示贴紧图形
  "spec": {  // › 分面里每个小图的画法
    "width": 640,  // › 宽度（像素）；"container" 表示撑满容器
    "height": 38,  // › 高度（像素）
    "view": {"stroke": null, "fill": null},  // › 单个视图（绘图区域）的样式，stroke:null 去掉外框
    "layer": [  // › 图层：多个图叠在同一个坐标系里，后写的在上面
      {
        "mark": {  // › 用什么图形来画（bar 柱 / point 点 / rect 方块 / area 面积 / text 文字 / geoshape 地图形状 …）
          "type": "area",  // › 画面积图
          "interpolate": "monotone",  // › 连线/颜色的插值方式（monotone 平滑；hcl 感知均匀的颜色混合）
          "fillOpacity": 0.88,  // › 填充的透明度
          "stroke": "#fbf8f3",  // › 边线颜色
          "strokeWidth": 1.2  // › 边线粗细（像素）
        },
        "encoding": {  // › 把数据字段映射到视觉通道（x、y、颜色、大小 …）
          "x": {  // › x 方向的位置
            "field": "value",  // › 使用数据里的 “value” 这一列
            "type": "quantitative",  // › 数据类型：定量（数字，连续）
            "title": null,  // › 不显示标题
            "scale": {"domain": [1979.5, 2026], "nice": false},  // › 比例尺：数据值如何映射到像素/颜色
            "axis": {  // › 坐标轴的外观；null 表示不显示坐标轴
              "format": "d",  // › 数字/日期的显示格式（d3-format，例如 d=整数，.0% 百分比）
              "values": [1987, 1995, 2000, 2005, 2010, 2015, 2020, 2025],  // › 手动指定显示哪些值（刻度/图例项），或内嵌数据行
              "grid": false,  // › 是否画网格线
              "domain": false,  // › 数据的取值范围（输入）
              "ticks": false  // › 是否画刻度线
            }
          },
          "y": {  // › y 方向的位置
            "field": "density",  // › 使用数据里的 “density” 这一列
            "type": "quantitative",  // › 数据类型：定量（数字，连续）
            "stack": null,  // › 不堆叠（各自从 0 开始）
            "scale": {"range": [38, -30]},  // › 比例尺：数据值如何映射到像素/颜色
            "axis": null  // › 不显示坐标轴
          },
          "color": {  // › 颜色通道：数据字段 → 颜色
            "field": "state",  // › 使用数据里的 “state” 这一列
            "type": "nominal",  // › 数据类型：名义（类别，没有顺序）
            "legend": null,  // › 不显示图例
            "scale": {  // › 比例尺：数据值如何映射到像素/颜色
              "domain": ["NSW", "VIC", "QLD", "WA", "SA", "TAS", "ACT", "NT"],  // › 数据的取值范围（输入）
              "range": [  // › 映射到的输出范围（像素、颜色列表 …）
                "#0072B2",
                "#CC79A7",
                "#D55E00",
                "#E69F00",
                "#009E73",
                "#56B4E9",
                "#8c7b6b",
                "#7a3b14"
              ]
            }
          },
          "tooltip": [  // › 鼠标悬停时显示的信息
            {"field": "state", "title": "State"},  // › 使用数据里的 “state", "title": "State"}” 这一列
            {"field": "total", "title": "Total wins"}  // › 使用数据里的 “total", "title": "Total wins"}” 这一列
          ]
        }
      },
      {
        "transform": [  // › 数据变换管道：按顺序一步一步加工数据，上一步的输出是下一步的输入
          {
            "aggregate": [{"op": "max", "field": "row_label", "as": "row_label"}],  // › 聚合：把多行合并成一行（count 数量 / sum 求和 / max 最大 …）
            "groupby": ["state"]  // › 按 ["state"] 分组，每组单独计算
          }
        ],
        "mark": {  // › 用什么图形来画（bar 柱 / point 点 / rect 方块 / area 面积 / text 文字 / geoshape 地图形状 …）
          "type": "text",  // › 画文字
          "align": "left",  // › 文字水平对齐
          "baseline": "bottom",  // › 文字垂直对齐
          "dx": 0,  // › 文字水平偏移（像素）
          "dy": -3,  // › 文字垂直偏移（像素）
          "fontSize": 11.5,  // › 字号
          "fontWeight": 700,  // › 字重（400 常规，700 粗体）
          "color": "#1f1c18"  // › 颜色通道：数据字段 → 颜色
        },
        "encoding": {  // › 把数据字段映射到视觉通道（x、y、颜色、大小 …）
          "x": {"datum": 1979.5, "type": "quantitative"},  // › x 方向的位置
          "y": {"datum": 0, "type": "quantitative"},  // › y 方向的位置
          "text": {"field": "row_label"}  // › 要显示的文字（来自字段或固定值）
        }
      }
    ]
  },
  "padding": {"top": 34, "left": 4, "right": 4, "bottom": 4}  // › 图四周留白，给标签/标题留空间
}
