// 图 2：分级着色地图 (choropleth) — Vega-Lite
// 每个州按“每百万人获奖数”（或类似比率）着色；用 lookup 把数据拼到地图的多边形上。
// 关键点：geoshape + lookup（TopoJSON 的 id ↔ csv 的 state）；颜色比例尺要用比率而不是总数。
// 面试一句话：Raw counts would just map population, so I normalised by population before colouring.
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",  // › 声明这是 Vega-Lite / Vega 的哪个版本，编辑器据此做提示
  "description": "Choropleth: ARIA wins per million residents, by state of the winner's hometown. Population = ABS estimated resident population, 31 March 2026.",  // › 这张图的文字说明（给读屏软件和读代码的人看，不影响画面）
  "width": 420,  // › 宽度（像素）；"container" 表示撑满容器
  "height": 380,  // › 高度（像素）
  "params": [  // › 参数/交互：滑块、下拉、选择区域 …，其他地方可以用名字引用
    {
      "name": "award",  // › 命名为 "award"，别处用这个名字引用
      "value": "All three awards",  // › 一个固定值（不是数据字段）
      "bind": {  // › 把参数绑到网页控件（滑块、单选、下拉）
        "input": "select",  // › 控件类型（radio 单选 / select 下拉 / range 滑块）
        "options": ["All three awards", "Album of the Year", "Best Group", "Best Country Album"],  // › 控件的可选值
        "name": "Award "  // › 命名为 "Award "，别处用这个名字引用
      }
    }
  ],
  "projection": {"type": "conicEqualArea", "parallels": [-18, -36], "rotate": [-132, 0]},  // › 地图投影：经纬度 → 平面坐标
  "layer": [  // › 图层：多个图叠在同一个坐标系里，后写的在上面
    {
      "data": {  // › 数据来源。url 指向 data/ 里的文件，或用 values 直接内嵌
        "url": "data/au_states.topo.json",  // › 读取文件 data/au_states.topo.json
        "format": {"type": "topojson", "feature": "states"}  // › 数字/日期的显示格式（d3-format，例如 d=整数，.0% 百分比）
      },
      "mark": {"type": "geoshape", "fill": "#e9e3d9", "stroke": "#fbf8f3", "strokeWidth": 1.2}  // › 用什么图形来画（bar 柱 / point 点 / rect 方块 / area 面积 / text 文字 / geoshape 地图形状 …）
    },
    {
      "data": {"url": "data/aria_wins.csv"},  // › 数据来源。url 指向 data/ 里的文件，或用 values 直接内嵌
      "transform": [  // › 数据变换管道：按顺序一步一步加工数据，上一步的输出是下一步的输入
        {"filter": "award === 'All three awards' || datum.category === award"},  // › 控件选了 All three awards 就全留，否则只留选中的奖项
        {"aggregate": [{"op": "count", "as": "wins"}], "groupby": ["state"]},  // › 聚合：把多行合并成一行（count 数量 / sum 求和 / max 最大 …）
        {
          "lookup": "state",  // › 查表：用 key 去另一个数据集里找对应行，把需要的字段拼进来
          "from": {  // › 这个 mark/数据 的数据来源
            "data": {"url": "data/source/abs_erp_2026q1.csv"},  // › 数据来源。url 指向 data/ 里的文件，或用 values 直接内嵌
            "key": "state",  // › 用来匹配的字段/键
            "fields": ["state_name", "population_thousands"]  // › 要运算的字段列表
          }
        },
        {"filter": "isValid(datum.state_name)"},  // › 只保留 lookup 成功（找到州）的行
        {"calculate": "datum.wins / (datum.population_thousands / 1000)", "as": "per_million"},  // › 新字段：每百万人获奖数 = 获奖数 ÷ 人口（人口原来是千人，除以 1000 变成百万）
        {
          "lookup": "state_name",  // › 查表：用 key 去另一个数据集里找对应行，把需要的字段拼进来
          "from": {  // › 这个 mark/数据 的数据来源
            "data": {  // › 数据来源。url 指向 data/ 里的文件，或用 values 直接内嵌
              "url": "data/au_states.topo.json",  // › 读取文件 data/au_states.topo.json
              "format": {"type": "topojson", "feature": "states"}  // › 数字/日期的显示格式（d3-format，例如 d=整数，.0% 百分比）
            },
            "key": "properties.STATE_NAME"  // › 用来匹配的字段/键
          },
          "as": "geo"  // › 计算结果存为新字段 "geo"
        },
        {
          "lookup": "state",  // › 查表：用 key 去另一个数据集里找对应行，把需要的字段拼进来
          "from": {  // › 这个 mark/数据 的数据来源
            "data": {"url": "data/state_points.csv"},  // › 数据来源。url 指向 data/ 里的文件，或用 values 直接内嵌
            "key": "state",  // › 用来匹配的字段/键
            "fields": ["lon", "lat"]  // › 要运算的字段列表
          }
        },
        {"calculate": "toNumber(datum.lon) + (datum.state === 'ACT' ? 4.4 : 0)", "as": "label_lon"},  // › 新字段：转成数字，并把 ACT 往东挪 4.4 度（它在海里面画，避免盖住 NSW）
        {
          "calculate": "toNumber(datum.lat) + (datum.state === 'ACT' ? 0.3 : datum.state === 'TAS' ? 0.5 : 0)",  // › 新字段：转成数字，并把 ACT、TAS 的圆稍微挪开避免重叠
          "as": "label_lat"  // › 计算结果存为新字段 "label_lat"
        }
      ],
      "layer": [  // › 图层：多个图叠在同一个坐标系里，后写的在上面
        {
          "mark": {"type": "geoshape", "stroke": "#fbf8f3", "strokeWidth": 1.2},  // › 用什么图形来画（bar 柱 / point 点 / rect 方块 / area 面积 / text 文字 / geoshape 地图形状 …）
          "encoding": {  // › 把数据字段映射到视觉通道（x、y、颜色、大小 …）
            "shape": {"field": "geo", "type": "geojson"},  // › 点的形状
            "color": {  // › 颜色通道：数据字段 → 颜色
              "field": "per_million",  // › 使用数据里的 “per_million” 这一列
              "type": "quantitative",  // › 数据类型：定量（数字，连续）
              "title": "Wins per million residents",  // › 标题文字；null 表示不要标题
              "scale": {  // › 比例尺：数据值如何映射到像素/颜色
                "type": "linear",  // › 线性比例尺
                "domain": [0, 8],  // › 数据的取值范围（输入）
                "range": ["#f6ecd3", "#e0b660", "#a36a12", "#5c3a08"],  // › 映射到的输出范围（像素、颜色列表 …）
                "interpolate": "hcl"  // › 连线/颜色的插值方式（monotone 平滑；hcl 感知均匀的颜色混合）
              },
              "legend": {  // › 图例的外观；null 表示不显示图例
                "orient": "bottom",  // › 放在图的哪一边（top/bottom/left/right）
                "direction": "horizontal",  // › 图例排列方向（horizontal/vertical）
                "gradientLength": 220,  // › 渐变图例条的长度（像素）
                "values": [0, 2, 4, 6, 8]  // › 手动指定显示哪些值（刻度/图例项），或内嵌数据行
              }
            },
            "tooltip": [  // › 鼠标悬停时显示的信息
              {"field": "state_name", "title": "State"},  // › 使用数据里的 “state_name", "title": "State"}” 这一列
              {"field": "wins", "title": "ARIA wins"},  // › 使用数据里的 “wins", "title": "ARIA wins"}” 这一列
              {
                "field": "population_thousands",  // › 使用数据里的 “population_thousands” 这一列
                "title": "Population ('000, ABS Mar 2026)",  // › 标题文字；null 表示不要标题
                "format": ",.1f"  // › 数字/日期的显示格式（d3-format，例如 d=整数，.0% 百分比）
              },
              {"field": "per_million", "title": "Wins per million people", "format": ".1f"}  // › 使用数据里的 “per_million", "title": "Wins per million people", "format": ".1f"}” 这一列
            ]
          }
        },
        {
          "mark": {"type": "text", "fontSize": 11, "fontWeight": 600, "lineHeight": 13},  // › 用什么图形来画（bar 柱 / point 点 / rect 方块 / area 面积 / text 文字 / geoshape 地图形状 …）
          "encoding": {  // › 把数据字段映射到视觉通道（x、y、颜色、大小 …）
            "longitude": {"field": "label_lon", "type": "quantitative"},  // › 经度字段
            "latitude": {"field": "label_lat", "type": "quantitative"},  // › 纬度字段
            "text": {"field": "label", "type": "nominal"},  // › 要显示的文字（来自字段或固定值）
            "color": {  // › 颜色通道：数据字段 → 颜色
              "condition": {  // › 条件样式：满足 test/param 时用这个值，否则用外面的默认值
                "test": "datum.per_million > 4.5 && datum.state !== 'ACT'",  // › 条件：每百万人 > 4.5 且不是 ACT（ACT 特殊处理，不放标签）
                "value": "#fffaf0"  // › 一个固定值（不是数据字段）
              },
              "value": "#2b2520"  // › 一个固定值（不是数据字段）
            }
          },
          "transform": [  // › 数据变换管道：按顺序一步一步加工数据，上一步的输出是下一步的输入
            {"calculate": "[datum.state, format(datum.per_million, '.1f')]", "as": "label"}  // › 新字段：两行标签：州名 + 每百万人获奖数（保留 1 位小数）
          ]
        }
      ]
    }
  ]
}
