// 图 1：比例符号地图 (proportional symbol map) — Vega-Lite
// 每个城市一个圆，面积 = 获奖数；Year 滑块 + Window 下拉 + Award 单选来过滤。
// 读法：先看 params（三个控件），再看 layer（底图 → 圆 → 标签 → 注释）。
// 关键点：投影 conicEqualArea；size 是面积；filter 里用 params 的名字联动。
// 面试一句话：I filter the points with three parameters bound to HTML controls, and layer the circles over a TopoJSON basemap.
{
 "$schema": "https://vega.github.io/schema/vega-lite/v5.json",  // › 声明这是 Vega-Lite / Vega 的哪个版本，编辑器据此做提示
 "description": "Proportional symbol map: hometowns of ARIA winners, circle area = number of wins, colour = ABS remoteness class. Filter by award and by period.",  // › 这张图的文字说明（给读屏软件和读代码的人看，不影响画面）
 "width": 640,  // › 宽度（像素）；"container" 表示撑满容器
 "height": 520,  // › 高度（像素）
 "params": [  // › 参数/交互：滑块、下拉、选择区域 …，其他地方可以用名字引用
  {
   "name": "category",  // › 命名为 "category"，别处用这个名字引用
   "value": "All three awards",  // › 一个固定值（不是数据字段）
   "bind": {  // › 把参数绑到网页控件（滑块、单选、下拉）
    "input": "radio",  // › 控件类型（radio 单选 / select 下拉 / range 滑块）
    "options": [  // › 控件的可选值
     "All three awards",
     "Album of the Year",
     "Best Group",
     "Best Country Album"
    ],
    "name": "Show "  // › 命名为 "Show "，别处用这个名字引用
   }
  },
  {
   "name": "upTo",  // › 命名为 "upTo"，别处用这个名字引用
   "value": 2025,  // › 一个固定值（不是数据字段）
   "bind": {  // › 把参数绑到网页控件（滑块、单选、下拉）
    "input": "range",  // › 控件类型（radio 单选 / select 下拉 / range 滑块）
    "min": 1987,  // › 最小值
    "max": 2025,  // › 最大值
    "step": 1,  // › 每个类别占多少像素（高度/宽度由类别数 × step 决定）
    "name": "Year "  // › 命名为 "Year "，别处用这个名字引用
   }
  },
  {
   "name": "windowYears",  // › 命名为 "windowYears"，别处用这个名字引用
   "value": "all",  // › 一个固定值（不是数据字段）
   "bind": {  // › 把参数绑到网页控件（滑块、单选、下拉）
    "input": "select",  // › 控件类型（radio 单选 / select 下拉 / range 滑块）
    "name": "Window ",  // › 命名为 "Window "，别处用这个名字引用
    "options": [  // › 控件的可选值
     "all",
     "1",
     "5",
     "10"
    ],
    "labels": [
     "Everything up to that year",
     "That year only",
     "The 5 years up to it",
     "The 10 years up to it"
    ]
   }
  }
 ],
 "projection": {  // › 地图投影：经纬度 → 平面坐标
  "type": "conicEqualArea",  // › 等面积圆锥投影，澳大利亚常用，面积不失真
  "parallels": [  // › 圆锥投影的两条标准纬线，决定变形最小的位置
   -18,
   -36
  ],
  "rotate": [  // › 旋转地球，把澳大利亚转到画面正中
   -132,
   0
  ]
 },
 "layer": [  // › 图层：多个图叠在同一个坐标系里，后写的在上面
  {
   "data": {  // › 数据来源。url 指向 data/ 里的文件，或用 values 直接内嵌
    "url": "data/au_states.topo.json",  // › 读取文件 data/au_states.topo.json
    "format": {  // › 数字/日期的显示格式（d3-format，例如 d=整数，.0% 百分比）
     "type": "topojson",  // › 文件格式是 TopoJSON（压缩的地图数据）
     "feature": "states"  // › TopoJSON 里要取出的对象名
    }
   },
   "mark": {  // › 用什么图形来画（bar 柱 / point 点 / rect 方块 / area 面积 / text 文字 / geoshape 地图形状 …）
    "type": "geoshape",  // › 画地图形状
    "fill": "#ebe4d8",  // › 填充色
    "stroke": "#fbf8f3",  // › 边线颜色
    "strokeWidth": 1.5  // › 边线粗细（像素）
   }
  },
  {
   "data": {  // › 数据来源。url 指向 data/ 里的文件，或用 values 直接内嵌
    "url": "data/aria_wins.csv",  // › 读取文件 data/aria_wins.csv
    "format": {  // › 数字/日期的显示格式（d3-format，例如 d=整数，.0% 百分比）
     "type": "csv",  // › 文件格式是 csv
     "parse": {  // › 指定列的数据类型，csv 默认都是文本，不 parse 就不能做数学运算
      "year": "number",
      "lat": "number",  // › 纬度（南纬为负）
      "lon": "number"  // › 经度（东经为正）
     }
    }
   },
   "transform": [  // › 数据变换管道：按顺序一步一步加工数据，上一步的输出是下一步的输入
    {
     "filter": "(category === 'All three awards' || datum.category === category) && (datum.year <= upTo && datum.year > upTo - (windowYears === 'all' ? 100 : toNumber(windowYears)))"  // › 点的过滤：奖项符合（All 或选中的）且 年份 ≤ Year 滑块 且 在 Window 窗口内（all 时窗口=100 年，相当于不限）
    },
    {
     "filter": "isValid(datum.lat)"  // › 只保留有纬度的行（有些获奖者没有家乡）
    },
    {
     "aggregate": [  // › 聚合：把多行合并成一行（count 数量 / sum 求和 / max 最大 …）
      {
       "op": "count",  // › 运算：count
       "as": "wins"  // › 计算结果存为新字段 "wins"
      },
      {
       "op": "distinct",  // › 运算：distinct
       "field": "artist",  // › 使用数据里的 “artist” 这一列
       "as": "artists"  // › 计算结果存为新字段 "artists"
      }
     ],
     "groupby": [  // › 按 [ 分组，每组单独计算
      "place",
      "state",
      "lat",
      "lon",
      "remoteness"
     ]
    }
   ],
   "layer": [  // › 图层：多个图叠在同一个坐标系里，后写的在上面
    {
     "mark": {  // › 用什么图形来画（bar 柱 / point 点 / rect 方块 / area 面积 / text 文字 / geoshape 地图形状 …）
      "type": "circle",  // › 画圆
      "opacity": 0.85,  // › 透明度 0（透明）~1（不透明）
      "stroke": "#fbf8f3",  // › 边线颜色
      "strokeWidth": 1  // › 边线粗细（像素）
     },
     "encoding": {  // › 把数据字段映射到视觉通道（x、y、颜色、大小 …）
      "longitude": {  // › 经度字段
       "field": "lon",  // › 使用数据里的 “lon” 这一列
       "type": "quantitative"  // › 数据类型：定量（数字，连续）
      },
      "latitude": {  // › 纬度字段
       "field": "lat",  // › 使用数据里的 “lat” 这一列
       "type": "quantitative"  // › 数据类型：定量（数字，连续）
      },
      "size": {  // › 大小
       "field": "wins",  // › 使用数据里的 “wins” 这一列
       "type": "quantitative",  // › 数据类型：定量（数字，连续）
       "scale": {  // › 比例尺：数据值如何映射到像素/颜色
        "domain": [  // › 数据的取值范围（输入）
         1,
         36
        ],
        "range": [  // › 映射到的输出范围（像素、颜色列表 …）
         45,
         2600
        ]
       },
       "legend": {  // › 图例的外观；null 表示不显示图例
        "title": "Wins",  // › 标题文字；null 表示不要标题
        "values": [  // › 手动指定显示哪些值（刻度/图例项），或内嵌数据行
         1,
         5,
         15,
         35
        ],
        "orient": "bottom-left",  // › 放在图的哪一边（top/bottom/left/right）
        "direction": "horizontal",  // › 图例排列方向（horizontal/vertical）
        "symbolFillColor": "#bdb3a4",  // › 图例符号填充色
        "symbolOpacity": 0.8  // › 图例符号透明度
       }
      },
      "color": {  // › 颜色通道：数据字段 → 颜色
       "field": "remoteness",  // › 使用数据里的 “remoteness” 这一列
       "type": "nominal",  // › 数据类型：名义（类别，没有顺序）
       "title": "Hometown is a…",  // › 标题文字；null 表示不要标题
       "scale": {  // › 比例尺：数据值如何映射到像素/颜色
        "domain": [  // › 数据的取值范围（输入）
         "Major city",
         "Inner regional",
         "Outer regional",
         "Remote",
         "Very remote"
        ],
        "range": [  // › 映射到的输出范围（像素、颜色列表 …）
         "#3b3f73",
         "#4f9d8a",
         "#d8a031",
         "#c4552d",
         "#7a2a1a"
        ]
       },
       "legend": {  // › 图例的外观；null 表示不显示图例
        "orient": "top-right",  // › 放在图的哪一边（top/bottom/left/right）
        "symbolType": "circle",  // › 图例符号形状
        "offset": 4  // › 离坐标轴/图形的距离
       }
      },
      "order": {  // › 顺序：{
       "field": "wins",  // › 使用数据里的 “wins” 这一列
       "sort": "descending"  // › 排序：descending
      },
      "tooltip": [  // › 鼠标悬停时显示的信息
       {
        "field": "place",  // › 使用数据里的 “place” 这一列
        "title": "Hometown"  // › 标题文字；null 表示不要标题
       },
       {
        "field": "state",  // › 使用数据里的 “state” 这一列
        "title": "State"  // › 标题文字；null 表示不要标题
       },
       {
        "field": "remoteness",  // › 使用数据里的 “remoteness” 这一列
        "title": "ABS remoteness"  // › 标题文字；null 表示不要标题
       },
       {
        "field": "wins",  // › 使用数据里的 “wins” 这一列
        "title": "ARIA wins"  // › 标题文字；null 表示不要标题
       },
       {
        "field": "artists",  // › 使用数据里的 “artists” 这一列
        "title": "Different artists"  // › 标题文字；null 表示不要标题
       }
      ]
     }
    },
    {
     "transform": [  // › 数据变换管道：按顺序一步一步加工数据，上一步的输出是下一步的输入
      {
       "filter": "datum.wins >= 4 || datum.place === 'Kerang' || windowYears !== 'all'"  // › 标签只显示获奖 ≥ 4 的城市、Kerang，或者选了窗口时全部显示
      },
      {
       "calculate": "datum.place + ' ' + datum.wins",  // › 新字段：标签：城市名 + 获奖数
       "as": "label"  // › 计算结果存为新字段 "label"
      },
      {
       "calculate": "datum.lat + (datum.place === 'Newcastle' ? 0.9 : datum.place === 'Sydney' ? -1.3 : datum.place === 'Canberra' ? -2 : 0)",  // › 新字段：给挤在一起的城市标签错开位置：纽卡斯尔 +0.9、悉尼 -1.3、堪培拉 -2（纬度偏移）
       "as": "label_lat"  // › 计算结果存为新字段 "label_lat"
      }
     ],
     "mark": {  // › 用什么图形来画（bar 柱 / point 点 / rect 方块 / area 面积 / text 文字 / geoshape 地图形状 …）
      "type": "text",  // › 画文字
      "align": "left",  // › 文字水平对齐
      "dx": 9,  // › 文字水平偏移（像素）
      "dy": -9,  // › 文字垂直偏移（像素）
      "fontSize": 11,  // › 字号
      "fontWeight": 600,  // › 字重（400 常规，700 粗体）
      "color": "#1f1c18"  // › 颜色通道：数据字段 → 颜色
     },
     "encoding": {  // › 把数据字段映射到视觉通道（x、y、颜色、大小 …）
      "longitude": {  // › 经度字段
       "field": "lon",  // › 使用数据里的 “lon” 这一列
       "type": "quantitative"  // › 数据类型：定量（数字，连续）
      },
      "latitude": {  // › 纬度字段
       "field": "label_lat",  // › 使用数据里的 “label_lat” 这一列
       "type": "quantitative"  // › 数据类型：定量（数字，连续）
      },
      "text": {  // › 要显示的文字（来自字段或固定值）
       "field": "label",  // › 使用数据里的 “label” 这一列
       "type": "nominal"  // › 数据类型：名义（类别，没有顺序）
      }
     }
    }
   ]
  },
  {
   "data": {  // › 数据来源。url 指向 data/ 里的文件，或用 values 直接内嵌
    "values": [  // › 手动指定显示哪些值（刻度/图例项），或内嵌数据行
     {
      "lon": 127.2,  // › 经度（东经为正）
      "lat": -14.6,  // › 纬度（南纬为负）
      "text": "Baker Boy, Milingimbi — the most remote",  // › 要显示的文字（来自字段或固定值）
      "text2": "hometown of any winner here (2022)",
      "showFor": "Album of the Year"  // › 图例/控件只对这些值显示
     },
     {
      "lon": 124.5,  // › 经度（东经为正）
      "lat": -36.2,  // › 纬度（南纬为负）
      "text": "Country music brings in small towns:",  // › 要显示的文字（来自字段或固定值）
      "text2": "Kerang, Corryong, Wemen, Southend",
      "showFor": "Best Country Album"  // › 图例/控件只对这些值显示
     }
    ]
   },
   "mark": {  // › 用什么图形来画（bar 柱 / point 点 / rect 方块 / area 面积 / text 文字 / geoshape 地图形状 …）
    "type": "text",  // › 画文字
    "align": "left",  // › 文字水平对齐
    "fontSize": 10.5,  // › 字号
    "fontStyle": "italic",  // › 字体样式（italic 斜体）
    "color": "#6b6157",  // › 颜色通道：数据字段 → 颜色
    "lineHeight": 14  // › 多行文字的行距
   },
   "encoding": {  // › 把数据字段映射到视觉通道（x、y、颜色、大小 …）
    "longitude": {  // › 经度字段
     "field": "lon",  // › 使用数据里的 “lon” 这一列
     "type": "quantitative"  // › 数据类型：定量（数字，连续）
    },
    "latitude": {  // › 纬度字段
     "field": "lat",  // › 使用数据里的 “lat” 这一列
     "type": "quantitative"  // › 数据类型：定量（数字，连续）
    },
    "text": {  // › 要显示的文字（来自字段或固定值）
     "field": "lines",  // › 使用数据里的 “lines” 这一列
     "type": "nominal"  // › 数据类型：名义（类别，没有顺序）
    }
   },
   "transform": [  // › 数据变换管道：按顺序一步一步加工数据，上一步的输出是下一步的输入
    {
     "filter": "(category === 'All three awards' || category === datum.showFor) && (datum.showFor !== 'Album of the Year' || (upTo >= 2022 && (windowYears === 'all' || upTo - toNumber(windowYears) < 2022)))"  // › 注释的过滤：奖项符合，且只有窗口包含 2022 年时才显示 Baker Boy 那条注释
    },
    {
     "calculate": "[datum.text, datum.text2]",  // › 新字段：把两行文字放进数组，会显示成上下两行
     "as": "lines"  // › 计算结果存为新字段 "lines"
    }
   ]
  }
 ]
}