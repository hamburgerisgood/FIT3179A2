// 图 6：Marimekko / 马赛克图 (mosaic) — Vega-Lite
// 柱宽 = 该州人口占比，柱高分段 = 各奖项占比；一眼看出“人口”和“获奖”是否成比例。
// 关键点：x 用 stack normalize 之后的累计位置（window 累计和）算出每个州的起点和终点，再用 x/x2 画矩形。
// 面试一句话：Width encodes population share and height encodes award mix, so both dimensions are visible at once.
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",  // › 声明这是 Vega-Lite / Vega 的哪个版本，编辑器据此做提示
  "description": "Marimekko (mosaic) chart: column width = a state's share of all wins; segments = which award those wins came from.",  // › 这张图的文字说明（给读屏软件和读代码的人看，不影响画面）
  "width": 960,  // › 宽度（像素）；"container" 表示撑满容器
  "height": 420,  // › 高度（像素）
  "data": {  // › 数据来源。url 指向 data/ 里的文件，或用 values 直接内嵌
    "url": "data/aria_wins.csv"  // › 读取文件 data/aria_wins.csv
  },
  "transform": [  // › 数据变换管道：按顺序一步一步加工数据，上一步的输出是下一步的输入
    {
      "filter": "datum.state !== 'Unknown'"  // › 去掉没有州信息的行
    },
    {
      "aggregate": [  // › 聚合：把多行合并成一行（count 数量 / sum 求和 / max 最大 …）
        {
          "op": "count",  // › 运算：count
          "as": "n"  // › 计算结果存为新字段 "n"
        }
      ],
      "groupby": [  // › 按 [ 分组，每组单独计算
        "state",
        "category"
      ]
    },
    {
      "joinaggregate": [  // › 聚合，但结果写回每一行，不会减少行数（用来给每行加“总数”之类）
        {
          "op": "sum",  // › 运算：sum
          "field": "n",  // › 使用数据里的 “n” 这一列
          "as": "state_total"  // › 计算结果存为新字段 "state_total"
        }
      ],
      "groupby": [  // › 按 [ 分组，每组单独计算
        "state"
      ]
    },
    {
      "calculate": "indexof(['Album of the Year', 'Best Group', 'Best Country Album'], datum.category)",  // › 新字段：奖项在列表里的位置（0/1/2），用来排序
      "as": "cat_order"  // › 计算结果存为新字段 "cat_order"
    },
    {
      "stack": "n",  // › 堆叠方式：null=不堆叠，"zero"=从 0 堆起，"normalize"=占比
      "groupby": [],  // › 按 [] 分组，每组单独计算
      "as": [  // › 计算结果存为新字段 [
        "s0",
        "s1"
      ],
      "offset": "normalize",  // › 离坐标轴/图形的距离
      "sort": [  // › 排序：[
        {
          "field": "state_total",  // › 使用数据里的 “state_total” 这一列
          "order": "descending"  // › 顺序：descending
        },
        {
          "field": "state",  // › 使用数据里的 “state” 这一列
          "order": "ascending"  // › 顺序：ascending
        },
        {
          "field": "cat_order",  // › 使用数据里的 “cat_order” 这一列
          "order": "ascending"  // › 顺序：ascending
        }
      ]
    },
    {
      "window": [  // › 窗口计算（排名 rank、累计和等），按 sort 排序后逐行算
        {
          "op": "min",  // › 运算：min
          "field": "s0",  // › 使用数据里的 “s0” 这一列
          "as": "x"  // › 计算结果存为新字段 "x"
        },
        {
          "op": "max",  // › 运算：max
          "field": "s1",  // › 使用数据里的 “s1” 这一列
          "as": "x2"  // › 计算结果存为新字段 "x2"
        }
      ],
      "groupby": [  // › 按 [ 分组，每组单独计算
        "state"
      ],
      "frame": [  // › 窗口范围 [向前, 向后]；[null,0] = 从开头累计到当前
        null,
        null
      ]
    },
    {
      "stack": "n",  // › 堆叠方式：null=不堆叠，"zero"=从 0 堆起，"normalize"=占比
      "groupby": [  // › 按 [ 分组，每组单独计算
        "state"
      ],
      "as": [  // › 计算结果存为新字段 [
        "y",
        "y2"
      ],
      "offset": "normalize",  // › 离坐标轴/图形的距离
      "sort": [  // › 排序：[
        {
          "field": "cat_order",  // › 使用数据里的 “cat_order” 这一列
          "order": "ascending"  // › 顺序：ascending
        }
      ]
    },
    {
      "calculate": "datum.n / datum.state_total",  // › 新字段：占比 = 该组数量 ÷ 该州总数
      "as": "pct_in_state"  // › 计算结果存为新字段 "pct_in_state"
    }
  ],
  "layer": [  // › 图层：多个图叠在同一个坐标系里，后写的在上面
    {
      "mark": {  // › 用什么图形来画（bar 柱 / point 点 / rect 方块 / area 面积 / text 文字 / geoshape 地图形状 …）
        "type": "rect",  // › 画矩形（热力图/方块图）
        "stroke": "#fbf8f3",  // › 边线颜色
        "strokeWidth": 2  // › 边线粗细（像素）
      },
      "encoding": {  // › 把数据字段映射到视觉通道（x、y、颜色、大小 …）
        "x": {  // › x 方向的位置
          "field": "x",  // › 使用数据里的 “x” 这一列
          "type": "quantitative",  // › 数据类型：定量（数字，连续）
          "scale": {  // › 比例尺：数据值如何映射到像素/颜色
            "domain": [  // › 数据的取值范围（输入）
              0,
              1
            ]
          },
          "axis": {  // › 坐标轴的外观；null 表示不显示坐标轴
            "format": "%",  // › 数字/日期的显示格式（d3-format，例如 d=整数，.0% 百分比）
            "title": "Share of all wins (column width)",  // › 标题文字；null 表示不要标题
            "values": [  // › 手动指定显示哪些值（刻度/图例项），或内嵌数据行
              0,
              0.25,
              0.5,
              0.75,
              1
            ],
            "grid": false  // › 是否画网格线
          }
        },
        "x2": {  // › 区间图形的另一端（x 方向终点）
          "field": "x2"  // › 使用数据里的 “x2” 这一列
        },
        "y": {  // › y 方向的位置
          "field": "y",  // › 使用数据里的 “y” 这一列
          "type": "quantitative",  // › 数据类型：定量（数字，连续）
          "scale": {  // › 比例尺：数据值如何映射到像素/颜色
            "domain": [  // › 数据的取值范围（输入）
              0,
              1.28
            ]
          },
          "axis": {  // › 坐标轴的外观；null 表示不显示坐标轴
            "format": "%",  // › 数字/日期的显示格式（d3-format，例如 d=整数，.0% 百分比）
            "title": "Share of the state's wins",  // › 标题文字；null 表示不要标题
            "values": [  // › 手动指定显示哪些值（刻度/图例项），或内嵌数据行
              0,
              0.5,
              1
            ],
            "grid": false,  // › 是否画网格线
            "domain": false  // › 数据的取值范围（输入）
          }
        },
        "y2": {  // › 区间图形的另一端（y 方向终点）
          "field": "y2"  // › 使用数据里的 “y2” 这一列
        },
        "color": {  // › 颜色通道：数据字段 → 颜色
          "field": "category",  // › 使用数据里的 “category” 这一列
          "type": "nominal",  // › 数据类型：名义（类别，没有顺序）
          "title": null,  // › 不显示标题
          "scale": {  // › 比例尺：数据值如何映射到像素/颜色
            "domain": [  // › 数据的取值范围（输入）
              "Album of the Year",
              "Best Group",
              "Best Country Album"
            ],
            "range": [  // › 映射到的输出范围（像素、颜色列表 …）
              "#c9971f",
              "#4a4e8c",
              "#6f8f3d"
            ]
          },
          "legend": {  // › 图例的外观；null 表示不显示图例
            "orient": "bottom",  // › 放在图的哪一边（top/bottom/left/right）
            "direction": "horizontal",  // › 图例排列方向（horizontal/vertical）
            "symbolType": "square",  // › 图例符号形状
            "offset": 6  // › 离坐标轴/图形的距离
          }
        },
        "tooltip": [  // › 鼠标悬停时显示的信息
          {
            "field": "state",  // › 使用数据里的 “state” 这一列
            "title": "State"  // › 标题文字；null 表示不要标题
          },
          {
            "field": "category",  // › 使用数据里的 “category” 这一列
            "title": "Award"  // › 标题文字；null 表示不要标题
          },
          {
            "field": "n",  // › 使用数据里的 “n” 这一列
            "title": "Wins"  // › 标题文字；null 表示不要标题
          },
          {
            "field": "pct_in_state",  // › 使用数据里的 “pct_in_state” 这一列
            "title": "Share of this state's wins",  // › 标题文字；null 表示不要标题
            "format": ".0%"  // › 数字/日期的显示格式（d3-format，例如 d=整数，.0% 百分比）
          }
        ]
      }
    },
    {
      "transform": [  // › 数据变换管道：按顺序一步一步加工数据，上一步的输出是下一步的输入
        {
          "filter": "datum.n >= 3"  // › 只保留数量 ≥ 3 的组
        },
        {
          "calculate": "(datum.x + datum.x2) / 2",  // › 新字段：矩形的中点 x，用来放文字
          "as": "xm"  // › 计算结果存为新字段 "xm"
        },
        {
          "calculate": "(datum.y + datum.y2) / 2",  // › 新字段：矩形的中点 y，用来放文字
          "as": "ym"  // › 计算结果存为新字段 "ym"
        }
      ],
      "mark": {  // › 用什么图形来画（bar 柱 / point 点 / rect 方块 / area 面积 / text 文字 / geoshape 地图形状 …）
        "type": "text",  // › 画文字
        "fontSize": 11,  // › 字号
        "fontWeight": 600,  // › 字重（400 常规，700 粗体）
        "color": "#fffaf0"  // › 颜色通道：数据字段 → 颜色
      },
      "encoding": {  // › 把数据字段映射到视觉通道（x、y、颜色、大小 …）
        "x": {  // › x 方向的位置
          "field": "xm",  // › 使用数据里的 “xm” 这一列
          "type": "quantitative"  // › 数据类型：定量（数字，连续）
        },
        "y": {  // › y 方向的位置
          "field": "ym",  // › 使用数据里的 “ym” 这一列
          "type": "quantitative"  // › 数据类型：定量（数字，连续）
        },
        "text": {  // › 要显示的文字（来自字段或固定值）
          "field": "n"  // › 使用数据里的 “n” 这一列
        }
      }
    },
    {
      "transform": [  // › 数据变换管道：按顺序一步一步加工数据，上一步的输出是下一步的输入
        {
          "aggregate": [  // › 聚合：把多行合并成一行（count 数量 / sum 求和 / max 最大 …）
            {
              "op": "min",  // › 运算：min
              "field": "x",  // › 使用数据里的 “x” 这一列
              "as": "x"  // › 计算结果存为新字段 "x"
            },
            {
              "op": "max",  // › 运算：max
              "field": "x2",  // › 使用数据里的 “x2” 这一列
              "as": "x2"  // › 计算结果存为新字段 "x2"
            },
            {
              "op": "max",  // › 运算：max
              "field": "state_total",  // › 使用数据里的 “state_total” 这一列
              "as": "total"  // › 计算结果存为新字段 "total"
            }
          ],
          "groupby": [  // › 按 [ 分组，每组单独计算
            "state"
          ]
        },
        {
          "calculate": "(datum.x + datum.x2) / 2",  // › 新字段：矩形的中点 x，用来放文字
          "as": "xm"  // › 计算结果存为新字段 "xm"
        },
        {
          "calculate": "datum.total >= 9 ? datum.state : ''",  // › 新字段：获奖 ≥ 9 才显示州名，否则显示空字符串（小块里放不下）
          "as": "label"  // › 计算结果存为新字段 "label"
        }
      ],
      "mark": {  // › 用什么图形来画（bar 柱 / point 点 / rect 方块 / area 面积 / text 文字 / geoshape 地图形状 …）
        "type": "text",  // › 画文字
        "baseline": "bottom",  // › 文字垂直对齐
        "dy": -4,  // › 文字垂直偏移（像素）
        "fontSize": 12,  // › 字号
        "fontWeight": 700,  // › 字重（400 常规，700 粗体）
        "color": "#1f1c18"  // › 颜色通道：数据字段 → 颜色
      },
      "encoding": {  // › 把数据字段映射到视觉通道（x、y、颜色、大小 …）
        "x": {  // › x 方向的位置
          "field": "xm",  // › 使用数据里的 “xm” 这一列
          "type": "quantitative"  // › 数据类型：定量（数字，连续）
        },
        "y": {  // › y 方向的位置
          "datum": 1  // › 一个固定值（不是数据字段），例如固定画在某个位置
        },
        "text": {  // › 要显示的文字（来自字段或固定值）
          "field": "label"  // › 使用数据里的 “label” 这一列
        }
      }
    },
    {
      "transform": [  // › 数据变换管道：按顺序一步一步加工数据，上一步的输出是下一步的输入
        {
          "aggregate": [  // › 聚合：把多行合并成一行（count 数量 / sum 求和 / max 最大 …）
            {
              "op": "min",  // › 运算：min
              "field": "x",  // › 使用数据里的 “x” 这一列
              "as": "x"  // › 计算结果存为新字段 "x"
            },
            {
              "op": "max",  // › 运算：max
              "field": "x2",  // › 使用数据里的 “x2” 这一列
              "as": "x2"  // › 计算结果存为新字段 "x2"
            },
            {
              "op": "max",  // › 运算：max
              "field": "state_total",  // › 使用数据里的 “state_total” 这一列
              "as": "total"  // › 计算结果存为新字段 "total"
            }
          ],
          "groupby": [  // › 按 [ 分组，每组单独计算
            "state"
          ]
        },
        {
          "calculate": "(datum.x + datum.x2) / 2",  // › 新字段：矩形的中点 x，用来放文字
          "as": "xm"  // › 计算结果存为新字段 "xm"
        },
        {
          "filter": "datum.total < 9"  // › 只给总数 < 9 的小块（另一个图层标注大块）
        },
        {
          "window": [  // › 窗口计算（排名 rank、累计和等），按 sort 排序后逐行算
            {
              "op": "row_number",  // › 运算：row_number
              "as": "rk"  // › 计算结果存为新字段 "rk"
            }
          ],
          "sort": [  // › 排序：[
            {
              "field": "xm",  // › 使用数据里的 “xm” 这一列
              "order": "ascending"  // › 顺序：ascending
            }
          ]
        },
        {
          "calculate": "1.07 + (datum.rk - 1) * 0.085",  // › 新字段：按名次排出标签的 y 位置，名次越后越往下
          "as": "ylab"  // › 计算结果存为新字段 "ylab"
        },
        {
          "calculate": "datum.state + ' · ' + datum.total + (datum.total === 1 ? ' win' : ' wins')",  // › 新字段：标签：州名 · 数量；数量为 1 时用单数 win，否则 wins
          "as": "label"  // › 计算结果存为新字段 "label"
        }
      ],
      "mark": {  // › 用什么图形来画（bar 柱 / point 点 / rect 方块 / area 面积 / text 文字 / geoshape 地图形状 …）
        "type": "rule",  // › 画线段
        "stroke": "#6b6157",  // › 边线颜色
        "strokeWidth": 1  // › 边线粗细（像素）
      },
      "encoding": {  // › 把数据字段映射到视觉通道（x、y、颜色、大小 …）
        "x": {  // › x 方向的位置
          "field": "xm",  // › 使用数据里的 “xm” 这一列
          "type": "quantitative"  // › 数据类型：定量（数字，连续）
        },
        "y": {  // › y 方向的位置
          "field": "ylab",  // › 使用数据里的 “ylab” 这一列
          "type": "quantitative"  // › 数据类型：定量（数字，连续）
        },
        "y2": {  // › 区间图形的另一端（y 方向终点）
          "datum": 1  // › 一个固定值（不是数据字段），例如固定画在某个位置
        }
      }
    },
    {
      "transform": [  // › 数据变换管道：按顺序一步一步加工数据，上一步的输出是下一步的输入
        {
          "aggregate": [  // › 聚合：把多行合并成一行（count 数量 / sum 求和 / max 最大 …）
            {
              "op": "min",  // › 运算：min
              "field": "x",  // › 使用数据里的 “x” 这一列
              "as": "x"  // › 计算结果存为新字段 "x"
            },
            {
              "op": "max",  // › 运算：max
              "field": "x2",  // › 使用数据里的 “x2” 这一列
              "as": "x2"  // › 计算结果存为新字段 "x2"
            },
            {
              "op": "max",  // › 运算：max
              "field": "state_total",  // › 使用数据里的 “state_total” 这一列
              "as": "total"  // › 计算结果存为新字段 "total"
            }
          ],
          "groupby": [  // › 按 [ 分组，每组单独计算
            "state"
          ]
        },
        {
          "calculate": "(datum.x + datum.x2) / 2",  // › 新字段：矩形的中点 x，用来放文字
          "as": "xm"  // › 计算结果存为新字段 "xm"
        },
        {
          "filter": "datum.total < 9"  // › 只给总数 < 9 的小块（另一个图层标注大块）
        },
        {
          "window": [  // › 窗口计算（排名 rank、累计和等），按 sort 排序后逐行算
            {
              "op": "row_number",  // › 运算：row_number
              "as": "rk"  // › 计算结果存为新字段 "rk"
            }
          ],
          "sort": [  // › 排序：[
            {
              "field": "xm",  // › 使用数据里的 “xm” 这一列
              "order": "ascending"  // › 顺序：ascending
            }
          ]
        },
        {
          "calculate": "1.07 + (datum.rk - 1) * 0.085",  // › 新字段：按名次排出标签的 y 位置，名次越后越往下
          "as": "ylab"  // › 计算结果存为新字段 "ylab"
        },
        {
          "calculate": "datum.state + ' · ' + datum.total + (datum.total === 1 ? ' win' : ' wins')",  // › 新字段：标签：州名 · 数量；数量为 1 时用单数 win，否则 wins
          "as": "label"  // › 计算结果存为新字段 "label"
        }
      ],
      "mark": {  // › 用什么图形来画（bar 柱 / point 点 / rect 方块 / area 面积 / text 文字 / geoshape 地图形状 …）
        "type": "text",  // › 画文字
        "align": "right",  // › 文字水平对齐
        "baseline": "middle",  // › 文字垂直对齐
        "dx": -5,  // › 文字水平偏移（像素）
        "fontSize": 11.5,  // › 字号
        "fontWeight": 700,  // › 字重（400 常规，700 粗体）
        "color": "#1f1c18"  // › 颜色通道：数据字段 → 颜色
      },
      "encoding": {  // › 把数据字段映射到视觉通道（x、y、颜色、大小 …）
        "x": {  // › x 方向的位置
          "field": "xm",  // › 使用数据里的 “xm” 这一列
          "type": "quantitative"  // › 数据类型：定量（数字，连续）
        },
        "y": {  // › y 方向的位置
          "field": "ylab",  // › 使用数据里的 “ylab” 这一列
          "type": "quantitative"  // › 数据类型：定量（数字，连续）
        },
        "text": {  // › 要显示的文字（来自字段或固定值）
          "field": "label"  // › 使用数据里的 “label” 这一列
        }
      }
    }
  ]
}
