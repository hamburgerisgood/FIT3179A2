{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Tile-grid map: one small chart per state, arranged roughly where the state sits on the map. Bars show wins per decade, split by award.",
  "data": {"url": "data/aria_wins.csv", "format": {"type": "csv", "parse": {"year": "number"}}},
  "transform": [
    {"filter": "datum.state !== 'Unknown'"},
    {"calculate": "floor(datum.year / 10) * 10 + 's'", "as": "decade"},
    {"aggregate": [{"op": "count", "as": "wins"}], "groupby": ["state", "decade", "category"]},
    {
      "lookup": "state",
      "from": {
        "data": {"url": "data/state_points.csv"},
        "key": "state",
        "fields": ["tile_row", "tile_col", "state_name"]
      }
    },
    {"calculate": "toNumber(datum.tile_row)", "as": "tile_row"},
    {"calculate": "toNumber(datum.tile_col)", "as": "tile_col"}
  ],
  "facet": {
    "row": {"field": "tile_row", "type": "ordinal", "header": null},
    "column": {"field": "tile_col", "type": "ordinal", "header": null}
  },
  "spacing": {"row": 10, "column": 10},
  "spec": {
    "width": 290,
    "height": 135,
    "encoding": {
      "x": {
        "field": "decade",
        "type": "ordinal",
        "scale": {
          "domain": ["1980s", "1990s", "2000s", "2010s", "2020s"],
          "paddingInner": 0.28,
          "paddingOuter": 0.4
        },
        "axis": null
      }
    },
    "layer": [
      {
        "transform": [{"aggregate": [{"op": "count", "as": "n"}], "groupby": ["state"]}],
        "mark": {
          "type": "rect",
          "x": 0,
          "y": 0,
          "x2": 290,
          "y2": 135,
          "fill": "#f1ebe1",
          "cornerRadius": 3
        },
        "encoding": {"x": null}
      },
      {
        "mark": {"type": "bar"},
        "encoding": {
          "y": {
            "field": "wins",
            "type": "quantitative",
            "aggregate": "sum",
            "scale": {"domain": [0, 12], "range": [112, 42]},
            "axis": null
          },
          "color": {
            "field": "category",
            "type": "nominal",
            "title": null,
            "scale": {
              "domain": ["Album of the Year", "Best Group", "Best Country Album"],
              "range": ["#c9971f", "#4a4e8c", "#6f8f3d"]
            },
            "legend": {"orient": "top", "direction": "horizontal", "symbolType": "square"}
          },
          "order": {"field": "category", "sort": "ascending"},
          "tooltip": [
            {"field": "state_name", "title": "State"},
            {"field": "decade", "title": "Decade"},
            {"field": "category", "title": "Award"},
            {"field": "wins", "aggregate": "sum", "title": "Wins"}
          ]
        }
      },
      {
        "transform": [
          {
            "aggregate": [{"op": "sum", "field": "wins", "as": "total"}],
            "groupby": ["state", "decade"]
          }
        ],
        "mark": {"type": "text", "dy": -6, "fontSize": 11, "color": "#5f574d"},
        "encoding": {
          "y": {
            "field": "total",
            "type": "quantitative",
            "scale": {"domain": [0, 12], "range": [112, 42]}
          },
          "text": {"field": "total"}
        }
      },
      {
        "transform": [
          {"aggregate": [{"op": "count", "as": "n"}], "groupby": ["state", "decade"]},
          {"calculate": "'’' + slice(datum.decade, 2)", "as": "short"}
        ],
        "mark": {"type": "text", "y": 126, "fontSize": 10.5, "color": "#8a7f72"},
        "encoding": {"text": {"field": "short"}}
      },
      {
        "transform": [
          {"aggregate": [{"op": "sum", "field": "wins", "as": "total"}], "groupby": ["state"]},
          {"calculate": "datum.state + ' · ' + datum.total", "as": "label"}
        ],
        "mark": {
          "type": "text",
          "align": "left",
          "baseline": "top",
          "fontSize": 14,
          "fontWeight": 700,
          "color": "#1f1c18",
          "x": 10,
          "y": 9
        },
        "encoding": {"x": null, "text": {"field": "label"}}
      }
    ]
  }
}
