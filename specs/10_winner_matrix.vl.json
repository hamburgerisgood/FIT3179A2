{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Matrix (heatmap-style) of every winner: one cell per award per year, coloured by the state of the winner's hometown. Click a state in the legend to highlight it.",
  "data": {"url": "data/aria_wins.csv", "format": {"type": "csv", "parse": {"year": "number"}}},
  "width": {"step": 15.5},
  "height": {"step": 34},
  "layer": [
    {
      "mark": {"type": "rect", "stroke": "#fbf8f3", "strokeWidth": 1.5, "cornerRadius": 2},
      "encoding": {
        "x": {
          "field": "year",
          "type": "ordinal",
          "title": null,
          "scale": {
            "domain": [
              1987,
              1988,
              1989,
              1990,
              1991,
              1992,
              1993,
              1994,
              1995,
              1996,
              1997,
              1998,
              1999,
              2000,
              2001,
              2002,
              2003,
              2004,
              2005,
              2006,
              2007,
              2008,
              2009,
              2010,
              2011,
              2012,
              2013,
              2014,
              2015,
              2016,
              2017,
              2018,
              2019,
              2020,
              2021,
              2022,
              2023,
              2024,
              2025
            ]
          },
          "axis": {
            "labelExpr": "datum.value % 5 === 0 || datum.value === 1987 ? datum.value : ''",
            "labelAngle": 0,
            "domain": false,
            "ticks": false,
            "labelOverlap": false
          }
        },
        "y": {
          "field": "category",
          "type": "nominal",
          "title": null,
          "sort": ["Album of the Year", "Best Group", "Best Country Album"],
          "axis": {
            "domain": false,
            "ticks": false,
            "labelFontWeight": 600,
            "labelColor": "#1f1c18",
            "labelFontSize": 11.5
          }
        },
        "color": {
          "field": "state",
          "type": "nominal",
          "title": "Winner's home state (click to highlight)",
          "scale": {
            "domain": ["NSW", "VIC", "QLD", "WA", "SA", "TAS", "ACT", "NT", "Unknown"],
            "range": [
              "#0072B2",
              "#CC79A7",
              "#D55E00",
              "#E69F00",
              "#009E73",
              "#56B4E9",
              "#8c7b6b",
              "#7a3b14",
              "#d8d1c5"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "symbolType": "square",
            "columns": 9,
            "titleLimit": 400,
            "labelExpr": "datum.label === 'Unknown' ? 'Not recorded' : datum.label"
          }
        },
        "opacity": {"condition": {"param": "stateSel", "value": 1}, "value": 0.15},
        "tooltip": [
          {"field": "year", "title": "Year"},
          {"field": "category", "title": "Award"},
          {"field": "winner", "title": "Winner"},
          {"field": "work", "title": "For"},
          {"field": "place", "title": "Hometown"},
          {"field": "state", "title": "State"}
        ]
      },
      "params": [
        {"name": "stateSel", "select": {"type": "point", "fields": ["state"]}, "bind": "legend"}
      ]
    },
    {
      "transform": [
        {"joinaggregate": [{"op": "count", "as": "career"}], "groupby": ["artist"]},
        {"filter": "datum.career >= 5"},
        {
          "calculate": "{'Kasey Chambers':'KC','Tame Impala':'TI','Troy Cassar-Daley':'TC','Powderfinger':'P'}[datum.artist]",
          "as": "initials"
        }
      ],
      "mark": {"type": "text", "fontSize": 8.5, "fontWeight": 700, "color": "#fffaf0"},
      "encoding": {
        "x": {"field": "year", "type": "ordinal"},
        "y": {
          "field": "category",
          "type": "nominal",
          "sort": ["Album of the Year", "Best Group", "Best Country Album"]
        },
        "text": {"field": "initials"},
        "opacity": {"condition": {"param": "stateSel", "value": 1}, "value": 0.15}
      }
    }
  ]
}
